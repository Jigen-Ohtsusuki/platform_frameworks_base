<?xml version="1.0" encoding="utf-8"?>
<!--
     Nothing-OS-style QS Customizer — premium layout.

     Color logic (swapped from stock):
       Active pane   = #E6000000  deep black — the edit grid feels "inset / focused"
       Inactive pane = @drawable/qs_customizer_background — QS-shade surface,
                       feels like the live panel and invites taps

     Side margins on both panes = @dimen/qs_panel_padding  (matches the live QS grid)
     No separator line — background contrast does the work
     No "Edit" label — space reclaimed for the tile grid
     Inactive header is centered, muted
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent spacer — absorbs system-icons area height for clip-circle origin -->
    <View
        android:id="@+id/customizer_transparent_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qs_header_system_icons_area_height"
        android:background="@android:color/transparent" />

    <com.android.keyguard.AlphaOptimizedLinearLayout
        android:id="@+id/customize_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/qs_customizer_background">

        <!-- ═══════════════════════════════════════════════════════════════════
             TOP BAR — back arrow only, transparent so active pane bg shows through
             ═══════════════════════════════════════════════════════════════════ -->
        <Toolbar
            android:id="@*android:id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:navigationContentDescription="@*android:string/action_bar_up_description"
            style="@style/QSCustomizeToolbar" />

        <!-- ═══════════════════════════════════════════════════════════════════
             ACTIVE PANE — deep black inset surface
             Side padding = qs_panel_padding, matching the live QS grid
             No label — full height given to the tile pager
             ═══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#E6000000"
            android:paddingStart="@dimen/qs_panel_padding"
            android:paddingEnd="@dimen/qs_panel_padding"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <!-- Paginated 4×4 active tile grid -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/active_tiles_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Pill-shaped page indicators, centered -->
            <LinearLayout
                android:id="@+id/page_indicator_container"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════════
             INACTIVE PANE — QS-shade surface (lighter than active pane)
             Feels like the live QS panel, inviting taps to add tiles
             Side padding = qs_panel_padding
             ═══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/qs_customizer_background"
            android:paddingStart="@dimen/qs_panel_padding"
            android:paddingEnd="@dimen/qs_panel_padding">

            <!-- Centered muted header — no "Edit" label -->
            <TextView
                android:id="@+id/inactive_tiles_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:text="@string/drag_to_add_tiles"
                android:textAppearance="@style/TextAppearance.QS.TileLabel"
                android:textColor="#66FFFFFF"
                android:letterSpacing="0.08"
                android:gravity="center" />

            <!-- Sectioned tile pool — no scrollbar -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/inactive_tiles_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingBottom="20dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:scrollbars="none" />

        </LinearLayout>

    </com.android.keyguard.AlphaOptimizedLinearLayout>

    <!-- Nav-bar backdrop (tablets / portrait only) -->
    <View
        android:id="@+id/nav_bar_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/navigation_bar_size"
        android:layout_gravity="bottom"
        android:background="#ff000000" />

</merge>
